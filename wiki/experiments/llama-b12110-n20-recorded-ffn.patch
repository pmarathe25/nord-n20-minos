+struct n20_ffn_replay {
+    static constexpr cl_command_queue_properties recordable = 1u << 30;
+    static constexpr cl_device_info max_dispatches = 0x41de;
+    using recording = n20_ffn_recording *;
+    using key = std::array<uint64_t, 12>;
+
+    cl_command_queue live_queue = nullptr;
+    cl_command_queue record_queue = nullptr;
+    recording (*create)(cl_command_queue, cl_int *) = nullptr;
+    cl_int (*end)(recording) = nullptr;
+    cl_int (*release)(recording) = nullptr;
+    cl_int (*enqueue)(cl_command_queue, recording, size_t, const n20_arg_update *,
+        size_t, const n20_offset_update *, size_t, const n20_workgroup_update *,
+        size_t, const n20_workgroup_update *, cl_uint, const cl_event *, cl_event *) = nullptr;
+
+    struct entry {
+        recording commands = nullptr;
+        std::array<cl_mem, 8> buffers{};
+    };
+    std::map<key, entry> cache;
+    bool tried_init = false;
+    bool capturing = false;
+    unsigned dispatches = 0;
+    cl_int status = CL_SUCCESS;
+    unsigned cold = 0;
+    unsigned built = 0;
+    unsigned hits = 0;
+    unsigned failures = 0;
+    unsigned resets = 0;
+
+    bool init(cl_context context, cl_device_id device, cl_command_queue queue) {
+        if (tried_init) {
+            return record_queue != nullptr;
+        }
+        tried_init = true;
+        cl_uint limit = 0;
+        if (clGetDeviceInfo(device, max_dispatches, sizeof(limit), &limit, nullptr) != CL_SUCCESS || limit < 3) {
+            GGML_LOG_INFO("n20: FFN recording unavailable\n");
+            return false;
+        }
+        create = reinterpret_cast<decltype(create)>(dlsym(RTLD_DEFAULT, "clNewRecordingQCOM"));
+        end = reinterpret_cast<decltype(end)>(dlsym(RTLD_DEFAULT, "clEndRecordingQCOM"));
+        release = reinterpret_cast<decltype(release)>(dlsym(RTLD_DEFAULT, "clReleaseRecordingQCOM"));
+        enqueue = reinterpret_cast<decltype(enqueue)>(dlsym(RTLD_DEFAULT, "clEnqueueRecordingQCOM"));
+        if (!create || !end || !release || !enqueue) {
+            GGML_LOG_INFO("n20: FFN recording entry points unavailable\n");
+            return false;
+        }
+        cl_int error;
+        record_queue = clCreateCommandQueue(context, device, recordable, &error);
+        if (error != CL_SUCCESS) {
+            record_queue = nullptr;
+            GGML_LOG_INFO("n20: FFN recordable queue unavailable (%d)\n", error);
+            return false;
+        }
+        live_queue = queue;
+        return true;
+    }
+
+    void reset() {
+        if (cache.empty()) {
+            return;
+        }
+        // Keep both the recording and its buffers alive while submitted work drains.
+        if (std::any_of(cache.begin(), cache.end(), [](const auto & pair) { return pair.second.commands != nullptr; })) {
+            clFinish(live_queue);
+        }
+        for (auto & pair : cache) {
+            auto & item = pair.second;
+            if (item.commands) {
+                release(item.commands);
+            }
+            for (auto buffer : item.buffers) {
+                if (buffer) {
+                    clReleaseMemObject(buffer);
+                }
+            }
+        }
+        cache.clear();
+        ++resets;
+    }
+
+    void disable() {
+        reset();
+        if (record_queue) {
+            clReleaseCommandQueue(record_queue);
+            record_queue = nullptr;
+        }
+    }
+
+    ~n20_ffn_replay() {
+        disable();
+        if (tried_init) {
+            GGML_LOG_INFO("n20: FFN recording cold=%u built=%u hits=%u failures=%u resets=%u\n",
+                cold, built, hits, failures, resets);
+        }
+    }
+};
+#endif
