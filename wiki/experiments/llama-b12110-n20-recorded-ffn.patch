+#ifdef N20_FFN_REPLAY_TRIAL
+static bool ggml_cl_try_n20_ffn_replay(ggml_backend_t backend, const ggml_cgraph * graph, int index) {
+    auto * ctx = static_cast<ggml_backend_opencl_context *>(backend->context);
+    auto & replay = ctx->ffn_replay;
+    if (ctx->gpu_family != ADRENO || g_ggml_backend_opencl_devices.size() != 1 ||
+        !ctx->kernel_n20_q2_decode || ctx->n20_q2_decode_max_workgroup < 512 ||
+        index + 2 >= graph->n_nodes) {
+        return false;
+    }
+
+    const auto * first = graph->nodes[index];
+    const auto * second = graph->nodes[index + 1];
+    const auto * glu = graph->nodes[index + 2];
+    if (second->op != GGML_OP_MUL_MAT || glu->op != GGML_OP_GLU ||
+        ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || ggml_get_op_params_i32(glu, 1) != 0 ||
+        !((glu->src[0] == first && glu->src[1] == second) ||
+          (glu->src[0] == second && glu->src[1] == first)) ||
+        !((first->flags & second->flags & glu->flags) & GGML_TENSOR_FLAG_COMPUTE)) {
+        return false;
+    }
+    const auto * input = first->src[1];
+    if (input != second->src[1]) {
+        return false;
+    }
+    const auto * w1 = first->src[0];
+    const auto * w2 = second->src[0];
+    const auto * buft = ggml_backend_get_default_buffer_type(backend);
+    for (const auto * tensor : std::array<const ggml_tensor *, 6>{first, second, glu, input, w1, w2}) {
+        if (!tensor->buffer || ggml_backend_buffer_get_type(tensor->buffer) != buft ||
+            !tensor->extra || tensor->ne[2] != 1 || tensor->ne[3] != 1 || !ggml_is_contiguous(tensor)) {
+            return false;
+        }
+    }
+    for (const auto * weight : {w1, w2}) {
+        if (weight->type != GGML_TYPE_Q2_0 || weight->view_src ||
+            weight->ne[0] != 2560 || weight->ne[1] != 9216 ||
+            !static_cast<const ggml_tensor_extra_cl_q2_0 *>(weight->extra)->noshuffle) {
+            return false;
+        }
+    }
+    for (const auto * activation : std::array<const ggml_tensor *, 4>{input, first, second, glu}) {
+        if (activation->type != GGML_TYPE_F32 || activation->ne[1] != 1 ||
+            activation->ne[0] != (activation == input ? 2560 : 9216)) {
+            return false;
+        }
+    }
+    if (!replay.init(ctx->context, ctx->device, ctx->queue)) {
+        return false;
+    }
+
+    const auto * q1 = static_cast<const ggml_tensor_extra_cl_q2_0 *>(w1->extra);
+    const auto * q2 = static_cast<const ggml_tensor_extra_cl_q2_0 *>(w2->extra);
+    const std::array<const ggml_tensor *, 4> activations{ input, first, second, glu };
+    std::array<cl_mem, 8> buffers{ q1->qs, q1->d, q2->qs, q2->d };
+    n20_ffn_replay::key key{};
+    for (size_t i = 0; i < activations.size(); ++i) {
+        const auto * extra = static_cast<const ggml_tensor_extra_cl *>(activations[i]->extra);
+        buffers[4 + i] = extra->data_device;
+        key[8 + i] = extra->offset + activations[i]->view_offs;
+    }
+    // Fixed contiguous shapes and fixed kernel selection leave only the buffers,
+    // byte offsets and gate/up order to distinguish otherwise identical dispatches.
+    for (size_t i = 0; i < buffers.size(); ++i) {
+        key[i] = reinterpret_cast<uintptr_t>(buffers[i]);
+    }
+    if (glu->src[0] != first) {
+        // Offsets are always a multiple of sizeof(float).
+        key.back() |= 1;
+    }
+    if (replay.cache.size() >= 64 && !replay.cache.count(key)) {
+        replay.reset();
+    }
+    auto [it, cold] = replay.cache.try_emplace(key);
+    if (cold) {
+        ++replay.cold;
+        return false;
+    }
+    auto & item = it->second;
+
+    if (!item.commands) {
+        replay.status = CL_SUCCESS;
+        replay.dispatches = 0;
+        auto commands = replay.create(replay.record_queue, &replay.status);
+        if (replay.status == CL_SUCCESS && commands) {
+            replay.capturing = true;
+            for (int i = index; i < index + 3; ++i) {
+                if (!ggml_cl_compute_forward(backend, graph->nodes[i])) {
+                    replay.status = CL_INVALID_OPERATION;
+                    break;
+                }
+            }
+            replay.capturing = false;
+            const auto status = replay.end(commands);
+            if (replay.status == CL_SUCCESS) {
+                replay.status = status;
+            }
+        }
+        if (replay.status == CL_SUCCESS && commands && replay.dispatches == 3) {
+            item.commands = commands;
+            for (size_t i = 0; i < buffers.size(); ++i) {
+                replay.status = clRetainMemObject(buffers[i]);
+                if (replay.status != CL_SUCCESS) {
+                    break;
+                }
+                item.buffers[i] = buffers[i];
+            }
+            if (replay.status == CL_SUCCESS) {
+                ++replay.built;
+            }
+        } else if (commands) {
+            replay.release(commands);
+        }
+        if (!item.commands || replay.status != CL_SUCCESS) {
+            ++replay.failures;
+            GGML_LOG_WARN("n20: FFN capture failed (%d, %u dispatches)\n", replay.status, replay.dispatches);
+            replay.disable();
+            return false;
+        }
+    } else {
+        ++replay.hits;
+        if (replay.hits == 1 || replay.hits % 128 == 0) {
+            GGML_LOG_INFO("n20: FFN replay hits=%u built=%u cold=%u resets=%u\n", replay.hits, replay.built, replay.cold, replay.resets);
+        }
+    }
+
+    const auto status = replay.enqueue(ctx->queue, item.commands, 0, nullptr, 0, nullptr,
+        0, nullptr, 0, nullptr, 0, nullptr, nullptr);
+    if (status != CL_SUCCESS) {
+        ++replay.failures;
+        GGML_LOG_WARN("n20: FFN enqueue failed (%d)\n", status);
+        replay.disable();
+        return false;
+    }
+    return true;
+}
