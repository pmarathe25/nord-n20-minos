+/* One atomic graph match: both inputs are the exact same tensor, and there is
+ * no intervening operation that can overwrite the queue's activation image or
+ * packed Q8 input. No activation is retained across graph matches. */
+static bool ggml_cl_try_n20_hybrid_pair(ggml_backend_t backend, const ggml_cgraph * graph, int index) {
+    auto *ctx=(ggml_backend_opencl_context *)backend->context;
+    if (!ctx->n20_q2_texture || !ctx->n20_hybrid_state || !ctx->n20_hybrid_reuse || index+2>=graph->n_nodes) return false;
