+    if (!first_hybrid || !ctx->n20_hybrid_reuse(ctx->n20_hybrid_state,(uint32_t)u->n20_dsp_slot,u->n20_dsp_unit,
+         (unsigned)n,(unsigned)padded,ctx->n20_q2_texture,u->qs,u->d,y->data_device,offset)) {
+        ggml_cl_mul_mat_q2_0_f32_adreno(backend,w1,input,second);
+    } else {
+        static std::once_flag trace;
+        std::call_once(trace, [] { GGML_LOG_INFO("n20: hybrid pair reuses activation packing\n"); });
+    }
+    return true;
+}
