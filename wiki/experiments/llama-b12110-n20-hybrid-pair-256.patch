+    if (!input || input!=second->src[1] || !w0 || !w1 || !w0->extra || !w1->extra ||
+        !input->extra || !first->extra || !second->extra || !w0->buffer || !w1->buffer || !first->buffer || !second->buffer ||
+        first->buffer==w0->buffer || first->buffer==w1->buffer || second->buffer==w0->buffer || second->buffer==w1->buffer ||
+        w0->type!=GGML_TYPE_Q2_0 || w1->type!=GGML_TYPE_Q2_0 ||
+        w0->view_src || w1->view_src || !ggml_is_contiguous(w0) || !ggml_is_contiguous(w1) || !ggml_are_same_shape(w0,w1) ||
+        w0->ne[0]!=2560 || w0->ne[1]!=9216 || w0->ne[2]!=1 || w0->ne[3]!=1 ||
+        input->type!=GGML_TYPE_F32 || input->ne[0]!=2560 || input->ne[1]<16 || input->ne[1]>256 || input->ne[2]!=1 || input->ne[3]!=1 ||
+        first->type!=GGML_TYPE_F32 || second->type!=GGML_TYPE_F32 ||
+        !ggml_is_contiguous(input) || !ggml_is_contiguous(first) || !ggml_is_contiguous(second) ||
+        !ggml_are_same_shape(first,second) || first->ne[0]!=9216 || first->ne[1]!=input->ne[1] || first->ne[2]!=1 || first->ne[3]!=1 ||
+        !((first->flags & second->flags) & GGML_TENSOR_FLAG_COMPUTE) ||
+        ggml_cl_tensors_overlap(input,first) || ggml_cl_tensors_overlap(input,second) || ggml_cl_tensors_overlap(first,second)) return false;
+    const auto *g=(const ggml_tensor_extra_cl_q2_0 *)w0->extra;
+    const auto *u=(const ggml_tensor_extra_cl_q2_0 *)w1->extra;
+    const auto *x=(const ggml_tensor_extra_cl *)input->extra;
+    const auto *y=(const ggml_tensor_extra_cl *)second->extra;
+    const int n=input->ne[1], padded=CEIL_DIV(n,8)*8;
+    if (!g->noshuffle || !u->noshuffle || g->n20_dsp_slot<0 || u->n20_dsp_slot<0 ||
+        g->n20_dsp_epoch!=ctx->n20_hybrid_epoch || u->n20_dsp_epoch!=ctx->n20_hybrid_epoch ||
+        (size_t)padded/4>N20_TEXTURE_WIDTH || (x->offset+input->view_offs)%ctx->alignment) return false;
+    bool first_hybrid=false;
