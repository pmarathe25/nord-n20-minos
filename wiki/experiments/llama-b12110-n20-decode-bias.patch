+    // Experimental decode-only block-sum reuse, isolated from the ordinary
+    // Q2 decode program. A failed setup leaves the original GPU path intact.
+    if (const char * path = getenv("N20_Q2_BIAS_SOURCE")) {
+        cl_command_queue_properties props = 0;
+        std::ifstream file(path, std::ios::binary);
+        const std::string source((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+        cl_int status = CL_SUCCESS;
+        cl_program program = nullptr;
+        if (!source.empty() && source.size() <= 1024*1024 &&
+            clGetCommandQueueInfo(backend_ctx->queue, CL_QUEUE_PROPERTIES, sizeof(props), &props, nullptr) == CL_SUCCESS &&
+            !(props & CL_QUEUE_OUT_OF_ORDER_EXEC_MODE_ENABLE)) {
+            const char * source_ptr = source.c_str();
+            const size_t source_size = source.size();
+            program = clCreateProgramWithSource(backend_ctx->context, 1, &source_ptr, &source_size, &status);
+            const std::string options = compile_opts + " -DQ2_0_MV_WIDE=1";
+            if (status == CL_SUCCESS && !program) status = CL_INVALID_PROGRAM;
+            if (status == CL_SUCCESS && program)
+                status = clBuildProgram(program, 1, &backend_ctx->device, options.c_str(), nullptr, nullptr);
+            if (status == CL_SUCCESS) {
+                backend_ctx->kernel_n20_q2_bias = clCreateKernel(program, "n20_q2_decode_bias64", &status);
+                if (status == CL_SUCCESS && !backend_ctx->kernel_n20_q2_bias) status = CL_INVALID_KERNEL;
+                if (status == CL_SUCCESS)
+                    backend_ctx->kernel_n20_q2_bias_decode = clCreateKernel(program, "kernel_gemv_noshuffle_q2_0_f32", &status);
+                if (status == CL_SUCCESS && !backend_ctx->kernel_n20_q2_bias_decode) status = CL_INVALID_KERNEL;
+                if (status == CL_SUCCESS && backend_ctx->get_kernel_workgroup_size(backend_ctx->kernel_n20_q2_bias_decode) >= 512)
+                    backend_ctx->n20_q2_bias_buffer = clCreateBuffer(backend_ctx->context, CL_MEM_READ_WRITE, 144*sizeof(float), nullptr, &status);
+                else if (status == CL_SUCCESS) status = CL_INVALID_WORK_GROUP_SIZE;
+            }
+        } else status = CL_INVALID_VALUE;
+        if (program) clReleaseProgram(program);
+        if (status != CL_SUCCESS || !backend_ctx->kernel_n20_q2_bias || !backend_ctx->kernel_n20_q2_bias_decode || !backend_ctx->n20_q2_bias_buffer) {
+            if (backend_ctx->kernel_n20_q2_bias) clReleaseKernel(backend_ctx->kernel_n20_q2_bias);
+            if (backend_ctx->kernel_n20_q2_bias_decode) clReleaseKernel(backend_ctx->kernel_n20_q2_bias_decode);
+            if (backend_ctx->n20_q2_bias_buffer) clReleaseMemObject(backend_ctx->n20_q2_bias_buffer);
+            backend_ctx->kernel_n20_q2_bias = nullptr; backend_ctx->kernel_n20_q2_bias_decode = nullptr;
+            backend_ctx->n20_q2_bias_buffer = nullptr;
+            GGML_LOG_WARN("n20: Q2 decode bias unavailable (%d); using ordinary GPU path\n", status);
