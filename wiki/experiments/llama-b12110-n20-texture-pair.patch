+// Only an adjacent pair with the identical input may share this in-order
+// queue's scratch texture. Both projection outputs remain real graph tensors.
+// No tensor pointer or contents are cached beyond these two dispatches.
+static bool ggml_cl_try_n20_q2_texture_pair(ggml_backend_t backend, const ggml_cgraph * graph, int index) {
+    auto * ctx = (ggml_backend_opencl_context *)backend->context;
+    if (!ctx->n20_q2_texture || !ctx->kernel_n20_q2_texture || index + 2 >= graph->n_nodes) return false;
+    auto * first = graph->nodes[index];
+    auto * second = graph->nodes[index + 1];
+    auto * glu = graph->nodes[index + 2];
+    if (first->op != GGML_OP_MUL_MAT || second->op != GGML_OP_MUL_MAT || glu->op != GGML_OP_GLU ||
+        !((glu->src[0] == first && glu->src[1] == second) ||
+          (glu->src[0] == second && glu->src[1] == first)) ||
+        ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || ggml_get_op_params_i32(glu, 1)) return false;
+    auto * input = first->src[1];
+    auto * w0 = first->src[0];
+    auto * w1 = second->src[0];
+    if (!input || input != second->src[1] || !w0 || !w1 || !w0->extra || !w1->extra ||
+        !input->extra || !first->extra || !second->extra ||
+        w0->type != GGML_TYPE_Q2_0 || w1->type != GGML_TYPE_Q2_0 ||
+        w0->view_src || w1->view_src || !ggml_is_contiguous(w0) || !ggml_is_contiguous(w1) || !ggml_are_same_shape(w0, w1) ||
+        w0->ne[0] != 2560 || w0->ne[1] != 9216 || w0->ne[2] != 1 || w0->ne[3] != 1 ||
+        input->type != GGML_TYPE_F32 || input->ne[0] != 2560 || input->ne[1] < 16 || input->ne[1] > 256 || input->ne[2] != 1 || input->ne[3] != 1 ||
+        first->type != GGML_TYPE_F32 || second->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(input) || !ggml_is_contiguous(first) || !ggml_is_contiguous(second) ||
+        !ggml_are_same_shape(first, second) || first->ne[0] != 9216 || first->ne[1] != input->ne[1] || first->ne[2] != 1 || first->ne[3] != 1 ||
+        !((first->flags & second->flags) & GGML_TENSOR_FLAG_COMPUTE) ||
+        ggml_cl_tensors_overlap(input, first) || ggml_cl_tensors_overlap(input, second) ||
+        ggml_cl_tensors_overlap(first, second)) return false;
+    const auto * g = (const ggml_tensor_extra_cl_q2_0 *)w0->extra;
+    const auto * u = (const ggml_tensor_extra_cl_q2_0 *)w1->extra;
+    const auto * x = (const ggml_tensor_extra_cl *)input->extra;
+    const auto * y = (const ggml_tensor_extra_cl *)second->extra;
+    const int n = input->ne[1];
+    const int m = 9216, k = 2560, padded = CEIL_DIV(n, 8) * 8;
+    if (!g->noshuffle || !u->noshuffle || n < 16 || (size_t)padded / 4 > N20_TEXTURE_WIDTH ||
+        (x->offset + input->view_offs) % ctx->alignment) return false;
+
+    // The ordinary path can select DP4A or fall back after a failed texture
+    // operation. Reuse only if it confirms the texture projection succeeded.
+    if (!ggml_cl_mul_mat_q2_0_f32_adreno(backend, w0, input, first)) {
+        ggml_cl_mul_mat_q2_0_f32_adreno(backend, w1, input, second);
+        return true;
+    }
+    const cl_mem texture = ctx->n20_q2_texture;
+    const cl_kernel kernel = ctx->kernel_n20_q2_texture;
+    const cl_ulong offset = y->offset + second->view_offs;
+    const void * args[] = { &u->qs, &u->d, &texture, &y->data_device, &offset, &m, &padded, &k, &n };
+    const size_t sizes[] = { sizeof(cl_mem), sizeof(cl_mem), sizeof(cl_mem), sizeof(cl_mem),
+                             sizeof(cl_ulong), sizeof(int), sizeof(int), sizeof(int), sizeof(int) };
+    cl_int status = CL_SUCCESS;
+    for (cl_uint i = 0; i < sizeof(args)/sizeof(args[0]) && status == CL_SUCCESS; ++i)
+        status = clSetKernelArg(kernel, i, sizes[i], args[i]);
+    size_t global[] = { (size_t)CEIL_DIV(n, 8), (size_t)CEIL_DIV(m, 512)*128, 1 };
+    size_t local[] = { 1, 128, 1 };
+    if (status == CL_SUCCESS) status = ctx->try_enqueue_ndrange_kernel(kernel, 3, global, local, second);
+    if (status != CL_SUCCESS) {
+        GGML_LOG_WARN("n20: paired activation texture dispatch failed (%d); using ordinary path\n", status);
+        ggml_cl_mul_mat_q2_0_f32_adreno(backend, w1, input, second);
+    } else {
+        static std::once_flag trace;
+        std::call_once(trace, [] { GGML_LOG_INFO("n20: paired Q2_0 projections share activation texture\n"); });
+    }
+    return true;
 }
 
