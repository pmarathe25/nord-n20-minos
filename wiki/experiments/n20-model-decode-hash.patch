+static uint64_t hash_logits(struct llama_context *context, int vocab_size, uint64_t hash) {
+    const float *logits = llama_get_logits_ith(context, -1);
+    require(logits != NULL, "No logits for hashing");
+    for (int i = 0; i < vocab_size; ++i) {
+        uint32_t bits;
+        memcpy(&bits, logits + i, sizeof(bits));
+        hash = (hash ^ bits) * UINT64_C(1099511628211);
+    }
+    return hash;
 }
 
