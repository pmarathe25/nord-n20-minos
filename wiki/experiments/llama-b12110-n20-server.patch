+    llama_tokens n20_prefix_tokens;
+    std::vector<uint8_t> n20_prefix_state;
+
+    int32_t n20_system_prefix(const server_slot & slot) const {
+        static const bool enabled = std::getenv("N20_KEEP_SYSTEM_PREFIX") != nullptr;
+        const auto & spans = slot.task->params.message_spans.spans;
+        if (!enabled || slots.size() != 1 || ctx_dft || mctx || !slot.lora.empty() ||
+            slot.task->type != SERVER_TASK_TYPE_COMPLETION || slot.task->is_stateless() ||
+            slot.task->n_tokens_shared != 0 || !slot.task->params.cache_prompt ||
+            spans.size() < 2 || spans[0].role != COMMON_CHAT_ROLE_SYSTEM ||
+            spans[1].role != COMMON_CHAT_ROLE_USER ||
+            spans[1].pos == 0 || spans[1].pos > 512 || spans[1].pos >= slot.task->tokens.size()) {
+            return 0;
+        }
+        return (int32_t)spans[1].pos;
+    }
+
+    void n20_save_prefix(const server_slot & slot, int64_t count, llama_pos min, llama_pos max) {
+        if (!n20_prefix_tokens.empty() || count <= 0 || count != n20_system_prefix(slot) ||
+            min < 0 || max != count - 1) {
+            return;
+        }
+        const size_t size = llama_state_seq_get_size(ctx_tgt, slot.id);
+        if (size == 0 || size > 64 * 1024 * 1024) {
+            return;
+        }
+        std::vector<uint8_t> state(size);
+        if (llama_state_seq_get_data(ctx_tgt, state.data(), size, slot.id) == size) {
+            const auto & tokens = slot.prompt.tokens.get_tokens();
+            n20_prefix_tokens.assign(tokens.begin(), tokens.begin() + count);
+            n20_prefix_state = std::move(state);
+            SRV_INF("n20: retained %d system tokens (%zu bytes)\n", (int)count, size);
+        }
+    }
+
+    void n20_restore_prefix(server_slot & slot, const server_tokens & input) {
+        if (n20_prefix_tokens.empty() || !slot.prompt.tokens.empty() ||
+            n20_prefix_tokens.size() != (size_t)n20_system_prefix(slot) ||
+            !std::equal(n20_prefix_tokens.begin(), n20_prefix_tokens.end(), input.get_tokens().begin()) ||
+            llama_memory_seq_pos_max(llama_get_memory(ctx_tgt), slot.id) >= 0) {
+            return;
+        }
+        const auto size = n20_prefix_state.size();
+        if (llama_state_seq_set_data(ctx_tgt, n20_prefix_state.data(), size, slot.id) == size) {
+            slot.prompt.tokens.insert(n20_prefix_tokens);
+            SRV_INF("n20: restored %zu system tokens\n", n20_prefix_tokens.size());
+        } else {
+            llama_memory_seq_rm(llama_get_memory(ctx_tgt), slot.id, -1, -1);
+            n20_prefix_tokens.clear();
+            n20_prefix_state.clear();
+        }
+    }
 
