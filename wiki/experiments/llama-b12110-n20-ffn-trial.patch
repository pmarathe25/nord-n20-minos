+static bool ggml_cl_try_n20_q2_ffn(ggml_backend_t backend, const ggml_cgraph * graph, int index) {
+    auto * ctx = (ggml_backend_opencl_context *)backend->context;
+    if (index + 2 >= graph->n_nodes || graph->nodes[index + 1]->op != GGML_OP_MUL_MAT ||
+        graph->nodes[index + 2]->op != GGML_OP_GLU) {
+        return false;
+    }
+    const auto * first = graph->nodes[index];
+    const auto * second = graph->nodes[index + 1];
+    const auto * glu = graph->nodes[index + 2];
+    const auto * gate = glu->src[0];
+    const auto * up = glu->src[1];
+    if (!((gate == first && up == second) || (gate == second && up == first)) ||
+        ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || ggml_get_op_params_i32(glu, 1)) {
+        return false;
+    }
+
+    const auto * input = gate->src[1];
+    const auto * wg = gate->src[0];
+    const auto * wu = up->src[0];
+    if (input != up->src[1] || wg->type != GGML_TYPE_Q2_0 || wu->type != GGML_TYPE_Q2_0 ||
+        wg->view_src || wu->view_src || !ggml_are_same_shape(wg, wu) ||
+        wg->ne[0] != 2560 || wg->ne[1] != 9216 || wg->ne[2] != 1 || wg->ne[3] != 1 ||
+        input->ne[2] != 1 || input->ne[3] != 1 ||
+        input->type != GGML_TYPE_F32 || glu->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(input) || !ggml_is_contiguous(glu) ||
+        !wg->extra || !wu->extra || !input->extra || !glu->extra ||
+        !ggml_are_same_shape(gate, glu) || !ggml_are_same_shape(up, glu) ||
+        !((gate->flags & up->flags & glu->flags) & GGML_TENSOR_FLAG_COMPUTE)) {
+        return false;
+    }
+    const auto * g = (const ggml_tensor_extra_cl_q2_0 *)wg->extra;
+    const auto * u = (const ggml_tensor_extra_cl_q2_0 *)wu->extra;
+    const auto * x = (const ggml_tensor_extra_cl *)input->extra;
+    const auto * y = (const ggml_tensor_extra_cl *)glu->extra;
+    const cl_ulong input_offset = x->offset + input->view_offs;
+    const cl_ulong output_offset = y->offset + glu->view_offs;
+    const int tokens = input->ne[1];
+    const bool decode = tokens == 1;
+    const cl_kernel kernel = decode ? ctx->kernel_n20_q2_ffn_decode : ctx->kernel_n20_q2_ffn_prefill;
+    if (!g->noshuffle || !u->noshuffle || !kernel ||
+        (decode ? ggml_cl_tensors_overlap(input, glu) : (tokens < 8 || input_offset % ctx->alignment))) {
+        return false;
+    }
+    const enum ggml_op ops[] = { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU };
+    const int outputs[] = { index + 2 };
+    if (!ggml_can_fuse_subgraph(graph, index, 3, ops, outputs, 1)) {
+        return false;
+    }
+
+    const int rows = wg->ne[1];
+    const int columns = wg->ne[0];
+    const int padded = CEIL_DIV(tokens, 8) * 8;
+    const cl_mem activation = decode ? x->data_device :
+        ggml_cl_q2_transpose_input(ctx, x, input_offset, tokens, columns, padded, glu);
+    CL_CHECK(clSetKernelArg(kernel, 0, sizeof(cl_mem), &g->qs));
+    CL_CHECK(clSetKernelArg(kernel, 1, sizeof(cl_mem), &g->d));
+    CL_CHECK(clSetKernelArg(kernel, 2, sizeof(cl_mem), &u->qs));
+    CL_CHECK(clSetKernelArg(kernel, 3, sizeof(cl_mem), &u->d));
+    CL_CHECK(clSetKernelArg(kernel, 4, sizeof(cl_mem), &activation));
+    if (decode) {
+        CL_CHECK(clSetKernelArg(kernel, 5, sizeof(cl_ulong), &input_offset));
+        CL_CHECK(clSetKernelArg(kernel, 6, sizeof(cl_mem), &y->data_device));
+        CL_CHECK(clSetKernelArg(kernel, 7, sizeof(cl_ulong), &output_offset));
+        CL_CHECK(clSetKernelArg(kernel, 8, sizeof(int), &rows));
+        CL_CHECK(clSetKernelArg(kernel, 9, sizeof(int), &columns));
+        size_t global[] = { (size_t)CEIL_DIV(rows, 128) * 32, 16 };
+        size_t local[] = { 32, 16 };
+        ctx->enqueue_ndrange_kernel(kernel, 2, global, local, glu);
+    } else {
+        CL_CHECK(clSetKernelArg(kernel, 5, sizeof(cl_mem), &y->data_device));
+        CL_CHECK(clSetKernelArg(kernel, 6, sizeof(cl_ulong), &output_offset));
+        CL_CHECK(clSetKernelArg(kernel, 7, sizeof(int), &rows));
+        CL_CHECK(clSetKernelArg(kernel, 8, sizeof(int), &padded));
+        CL_CHECK(clSetKernelArg(kernel, 9, sizeof(int), &columns));
+        CL_CHECK(clSetKernelArg(kernel, 10, sizeof(int), &tokens));
+        size_t global[] = { (size_t)CEIL_DIV(tokens, 8), (size_t)CEIL_DIV(rows, 256) * 128 };
+        size_t local[] = { 1, 128 };
+        ctx->enqueue_ndrange_kernel(kernel, 2, global, local, glu);
+        CL_CHECK(clReleaseMemObject(activation));
+    }
+    static std::once_flag traces[2];
+    std::call_once(traces[decode], [&] { GGML_LOG_INFO("n20: fused Q2_0 FFN %s\n", decode ? "decode" : "prefill"); });
+    return true;
+}
