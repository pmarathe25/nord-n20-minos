+    bool n20_write_prefix(int dir, const llama_tokens & tokens, const std::vector<uint8_t> & state) const {
+        n20_prefix_header header;
+        std::memcpy(header.key, std::getenv("N20_PREFIX_KEY"), sizeof(header.key));
+        const auto digest = n20_prefix_digest(tokens, state);
+        std::memcpy(header.digest, digest.data(), sizeof(header.digest));
+        header.count = tokens.size();
+        header.size = state.size();
+        const std::string temp = "prefix.tmp." + std::to_string(getpid());
+        const int fd = openat(dir, temp.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+        if (fd < 0) {
+            return false;
+        }
+        FILE * file = fdopen(fd, "wb");
+        bool ok = file &&
+            std::fwrite(&header, sizeof(header), 1, file) == 1 &&
+            std::fwrite(tokens.data(), sizeof(tokens[0]), tokens.size(), file) == tokens.size() &&
+            std::fwrite(state.data(), 1, state.size(), file) == state.size() &&
+            std::fflush(file) == 0 && fsync(fd) == 0;
+        const int closed = file ? std::fclose(file) : close(fd);
+        ok = ok && closed == 0 && renameat(dir, temp.c_str(), dir, "prefix.state") == 0;
+        if (ok) {
+            fsync(dir);
+        } else {
+            unlinkat(dir, temp.c_str(), 0);
+        }
+        return ok;
+    }
