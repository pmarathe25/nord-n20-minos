+    static std::string n20_prefix_digest(const llama_tokens & tokens, const std::vector<uint8_t> & state) {
+        const std::string hashes = std::string(std::getenv("N20_PREFIX_KEY")) +
+            hash_sha256_hex(tokens.data(), tokens.size() * sizeof(llama_token)) +
+            hash_sha256_hex(state.data(), state.size());
+        return hash_sha256_hex(hashes.data(), hashes.size());
+    }
