+        if (std::fread(&header, sizeof(header), 1, raw) != 1 ||
+            std::memcmp(header.version, expected.version, sizeof(header.version)) != 0 ||
+            std::memcmp(header.key, std::getenv("N20_PREFIX_KEY"), sizeof(header.key)) != 0 ||
+            header.count != count || header.size == 0 || header.size > n20_prefix_max ||
+            st.st_size != (off_t)(sizeof(header) + count * sizeof(llama_token) + header.size)) {
