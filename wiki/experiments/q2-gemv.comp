#version 450
#extension GL_KHR_shader_subgroup_shuffle : require

layout(local_size_x = 128) in;
layout(set = 0, binding = 0, std430) readonly buffer Weights {
    uint weights[];
};
layout(set = 0, binding = 1, std430) readonly buffer Input {
    vec4 input_vector[];
};
layout(set = 0, binding = 2, std430) writeonly buffer Output {
    float output_vector[];
};
layout(push_constant) uniform Shape {
    uint blocks_per_row;
    uint scale_start;
    uint row_count;
};

void main() {
    const uint row_in_group = gl_SubgroupID * (gl_SubgroupSize / 16) + gl_SubgroupInvocationID / 16;
    const uint row = gl_WorkGroupID.x * 8 + row_in_group;
    const uint lane = gl_SubgroupInvocationID % 16;
    float total = 0.0;
    for (uint part = lane; row < row_count && part < blocks_per_row * 4; part += 16) {
        const uint block = row * blocks_per_row + part / 4;
        uint packed = weights[block * 4 + part % 4];
        float dot_product = 0.0;
        for (uint quad = 0; quad < 4; ++quad) {
            const vec4 decoded = vec4((uvec4(packed) >> uvec4(0, 2, 4, 6)) & 3) - 1.0;
            dot_product += dot(decoded, input_vector[part * 4 + quad]);
            packed >>= 8;
        }
        const vec2 scales = unpackHalf2x16(weights[scale_start + block / 2]);
        total += dot_product * scales[block % 2];
    }
    for (uint step = 8; step != 0; step >>= 1) {
        total += subgroupShuffleXor(total, step);
    }
    if (lane == 0 && row < row_count) {
        output_vector[row] = total;
    }
}
