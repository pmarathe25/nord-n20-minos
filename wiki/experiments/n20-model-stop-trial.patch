+static bool append_and_stop(const struct llama_vocab *vocab, llama_token token,
+                            char *text, size_t *used) {
+    char piece[512];
+    const int n = llama_token_to_piece(vocab, token, piece, sizeof(piece), 0, true);
+    require(n >= 0 && n < (int)sizeof(piece), "Unexpected token piece length");
+    require(*used + (size_t)n < MAX_PROMPT_BYTES, "Generated text buffer exhausted");
+    memcpy(text + *used, piece, (size_t)n);
+    *used += (size_t)n;
+    text[*used] = 0;
+    return llama_vocab_is_eog(vocab, token) || strstr(text, "\n\n") != NULL;
 }
 
