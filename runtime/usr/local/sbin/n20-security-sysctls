#!/bin/sh
# Enable filesystem protections for the game-owned server directory and /tmp.
set -eu
directory=/proc/sys/fs
root=
check_paths=1
if [ "$#" -eq 2 ] && [ "$1" = --test-dir ]; then
    directory=$2
    check_paths=0
elif [ "$#" -eq 2 ] && [ "$1" = --test-root ]; then
    root=$2
    directory=$root/proc/sys/fs
elif [ "$#" -ne 0 ]; then
    echo 'Invalid security-sysctl argument' >&2; exit 2
fi
if [ "$check_paths" -eq 1 ]; then
    # These parents and libraries are used by root-run services.  A writable
    # parent permits replacing a protected file even if that file is mode 755.
    for suffix in / /usr /usr/bin /usr/sbin /usr/lib /usr/lib/aarch64-linux-gnu /usr/lib/python3 /usr/lib/python3.13 /usr/lib/python3/dist-packages /usr/share /usr/local /usr/local/bin /usr/local/sbin /usr/local/lib /usr/local/share /usr/local/share/ca-certificates /usr/local/lib/n20 /usr/local/lib/n20-radio /usr/local/lib/n20-radio/android /usr/local/lib/n20-radio/qrtr /etc /etc/ssh /opt /opt/java /opt/java/bin /opt/java/lib /opt/java/conf /opt/n20-minecraft; do
        path=$root$suffix
        [ -e "$path" ] || [ -L "$path" ] || continue
        [ ! -L "$path" ] && [ -d "$path" ] && [ "$(stat -c '%u' "$path")" = 0 ] || { echo "Unsafe privileged directory: $path" >&2; exit 1; }
        chmod go-w "$path" || exit 1
    done
    for suffix in /usr/local/bin /usr/local/sbin /usr/local/lib/n20 /usr/local/lib/n20-radio /usr/local/share/ca-certificates /opt/java/bin /opt/java/lib /opt/java/conf /opt/n20-minecraft; do
        path=$root$suffix
        [ -d "$path" ] || continue
        owners=$(find "$path" -xdev ! -uid 0 -print -quit) || { echo "Cannot inspect privileged path: $path" >&2; exit 1; }
        [ -z "$owners" ] || { echo "Untrusted owner in privileged path: $path" >&2; exit 1; }
        # Local library aliases are needed, but links must not escape the
        # protected, root-owned tree to reach an attacker-controlled target.
        find "$path" -xdev -type l -exec sh -c '
            for link do
                target=$(readlink -- "$link") || exit 1
                case "$target" in ""|.|..|*/*) echo "Unsafe privileged symlink: $link" >&2; exit 1;; esac
            done
        ' sh {} + || exit 1
        find "$path" -xdev \( -type f -o -type d \) -perm /022 -exec chmod go-w {} + || exit 1
    done
fi
for key in protected_hardlinks protected_symlinks protected_fifos protected_regular; do
    file=$directory/$key
    [ -f "$file" ] || { echo "Missing kernel protection: $key" >&2; exit 1; }
    printf '1\n' > "$file" || { echo "Cannot enable kernel protection: $key" >&2; exit 1; }
    [ "$(cat "$file")" = 1 ] || { echo "Kernel protection not active: $key" >&2; exit 1; }
done
