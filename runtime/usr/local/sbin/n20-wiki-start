#!/bin/sh
# Start the Wiki worker with the Nord N20's C.24 OpenCL runtime.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077
bundle=/opt/n20-wiki
backend=$bundle/opencl
android=/usr/local/lib/n20-radio/android
run=/run/n20-wiki
uid=61124
enabled=/etc/n20-wiki-enabled
tuned_enabled=/etc/n20-wiki-opencl-tuned
texture_enabled=/etc/n20-wiki-opencl-texture
gdn_enabled=/etc/n20-wiki-opencl-gdn2
prefix_enabled=/etc/n20-wiki-disk-prefix
worker_config=/usr/local/lib/n20/wiki_prefix.py
texture_shader_dir=/var/lib/n20-wiki/shaders-texture
gdn_shader_dir=/var/lib/n20-wiki/shaders-texture-gdn2

case "$#" in
    0) [ -f "$enabled" ] || exit 0 ;;
    1) [ "$1" = --devices-only ] || exit 2 ;;
    *) exit 2 ;;
esac
exec 9>/run/n20/wiki.lock
flock -n 9 || exit 0

node() {
    path=$1
    IFS=: read -r major minor < "$2"
    [ -n "$major" ] && [ -n "$minor" ] || return 1
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
        mknod -m 600 "$path" c "$major" "$minor"
        chown "0:$uid" "$path"
        chmod 660 "$path"
    fi
    [ ! -L "$path" ] && [ -c "$path" ] || return 1
    [ "$(stat -c '%u:%g:%a:%t:%T' "$path")" = "0:$uid:660:$(printf '%x:%x' "$major" "$minor")" ]
}

node /dev/kgsl-3d0 /sys/class/kgsl/kgsl-3d0/dev
node /dev/ion /sys/class/misc/ion/dev
[ "$#" -eq 0 ] || exit 0
[ -r "$bundle/model.gguf" ] && [ -x "$backend/bin/llama-server" ] && [ -x "$bundle/n20-wiki" ] || exit 1
[ -x "$android/linker64" ] && [ -r "$backend/cl-compat.so" ] || exit 1
install -d -m 755 "$run"
install -d -o "$uid" -g "$uid" -m 2750 "$run/model"
install -d -o minecraft -g minecraft -m 750 "$run/status"
install -d -o minecraft -g minecraft -m 700 /var/lib/n20-wiki/history
sock=$run/model/llama.sock
rm -f "$sock"
model=
bridge=
cleanup() {
    trap - EXIT HUP INT TERM
    for pid in "$bridge" "$model"; do
        [ -z "$pid" ] || kill "$pid" 2>/dev/null || :
    done
    for pid in "$bridge" "$model"; do
        [ -z "$pid" ] || wait "$pid" 2>/dev/null || :
    done
    rm -f "$sock"
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM

run_model() {
    umask 007
    ulimit -c 0
    cd "$backend"
    profile=$1
    action=${2:-launch}
    texture_key=${3:-}
    prefix_dir=/var/lib/n20-wiki/prefix
    shader_dir=/var/lib/n20-wiki/shaders/opencl
    if [ "$profile" = texture ] || [ "$profile" = texture-gdn2 ]; then
        shader_dir=$texture_shader_dir
        if [ "$profile" = texture-gdn2 ]; then
            shader_dir=$gdn_shader_dir
        fi
        set -- --ubatch-size 256
    else
        set --
    fi
    set -- "LD_PRELOAD=$backend/cl-compat.so" \
        "LD_LIBRARY_PATH=$backend/vendor:$android:$backend/system:$backend/bin" \
        "GGML_OPENCL_KERNEL_CACHE_DIR=$shader_dir" \
        "$android/linker64" "$backend/bin/llama-server" --model "$bundle/model.gguf" \
        --host "$sock" --device GPUOpenCL --gpu-layers 99 --fit off --ctx-size 4096 \
        --parallel 1 --cache-ram 0 --threads 2 --threads-batch 2 --threads-http 2 --no-webui --no-slots \
        --sleep-idle-seconds 90 --timeout 360 "$@"
    if [ "$profile" != stock ]; then
        kernels=$bundle/kernels
        prefix_dir=/var/lib/n20-wiki/prefix-tuned
        set -- "N20_Q2_PREFILL_SOURCE=$kernels/n20-q2-prefill-64.cl" \
            "N20_Q2_DECODE_SOURCE=$kernels/n20-q2-decode.cl" \
            "N20_Q2_PACK_SOURCE=$kernels/n20-q2-pack.cl" \
            "N20_FWHT_RADIX_SOURCE=$kernels/n20-fwht-radix.cl" \
            N20_Q2_TAIL=1 N20_Q2_WIDE_VOCAB=1 N20_SINGLE_ROW_COPY=1 N20_WIKI_SINGLE_TURN=1 "$@"
    fi
    if [ "$profile" = texture ] || [ "$profile" = texture-gdn2 ]; then
        prefix_dir=/var/lib/n20-wiki/prefix-texture
        set -- "N20_Q2_TEXTURE_SOURCE=$kernels/n20-q2-activation-image-prefill.cl" "$@"
        if [ "$profile" = texture-gdn2 ]; then
            prefix_dir=/var/lib/n20-wiki/prefix-texture-gdn2
            set -- N20_GDN_CPL=2 "$@"
        fi
    fi
    if [ "$action" = prepare-texture ]; then
        if [ -f "$prefix_enabled" ] && [ ! -L "$prefix_enabled" ]; then
            exec nice -n 15 taskset -c 0-2 /usr/bin/python3 -IB "$worker_config" --prepare-texture \
                "$bundle" "$android" "$texture_enabled" "$shader_dir" "$uid" \
                "$prefix_dir" -- N20_KEEP_SYSTEM_PREFIX=1 "$@"
        fi
        exec nice -n 15 taskset -c 0-2 /usr/bin/python3 -IB "$worker_config" --prepare-texture \
            "$bundle" "$android" "$texture_enabled" "$shader_dir" "$uid"
    fi
    if [ "$profile" = texture ] || [ "$profile" = texture-gdn2 ]; then
        if [ -n "$texture_key" ]; then
            set -- N20_KEEP_SYSTEM_PREFIX=1 \
                "N20_PREFIX_DIR=$prefix_dir" "N20_PREFIX_KEY=$texture_key" "$@"
        fi
    elif [ -f "$prefix_enabled" ] && [ ! -L "$prefix_enabled" ]; then
        if prefix_key=$(nice -n 15 taskset -c 0-2 /usr/bin/python3 -IB \
            "$worker_config" "$bundle" "$android" "$prefix_dir" "$uid" -- \
            N20_KEEP_SYSTEM_PREFIX=1 "$@"); then
            set -- N20_KEEP_SYSTEM_PREFIX=1 \
                "N20_PREFIX_DIR=$prefix_dir" "N20_PREFIX_KEY=$prefix_key" "$@"
        fi
    fi
    exec setpriv --no-new-privs --bounding-set=-all --reuid="$uid" --regid="$uid" --clear-groups \
        nice -n 15 taskset -c 0-2 env -i "$@"
}

profile=stock
texture_key=
configure_profile() {
if [ -e "$tuned_enabled" ] || [ -L "$tuned_enabled" ]; then
    if /usr/bin/python3 -IB "$worker_config" --check-tuned "$bundle" "$android" "$tuned_enabled"; then
        profile=tuned
        if [ -e "$texture_enabled" ] || [ -L "$texture_enabled" ]; then
            texture_profile=texture
            if [ -e "$gdn_enabled" ] || [ -L "$gdn_enabled" ]; then
                if /usr/bin/python3 -IB "$worker_config" --check-gdn \
                    "$bundle" "$android" "$gdn_enabled" "$gdn_shader_dir" "$uid"; then
                    texture_profile=texture-gdn2
                fi
            fi
            if texture_key=$(run_model "$texture_profile" prepare-texture); then
                profile=$texture_profile
            fi
        fi
        echo "n20-wiki: starting $profile OpenCL worker" >&2
    fi
fi
}

# Model loading can consume more than 2 GiB on this device. Keep a wider
# reserve before starting it and stop it if active gameplay uses that reserve.
memory_at_least() {
    awk -v limit="$1" '/^MemAvailable:/ { ok = ($2 >= limit) } END { exit !ok }' /proc/meminfo
}
temperature_ok() {
    awk '{ ok = ($1 ~ /^[0-9]+$/ && $1 < 400) } END { exit !ok }' /sys/class/power_supply/battery/temp
}
swap_at_least() {
    awk -v limit="$1" '/^SwapFree:/ { ok = ($2 >= limit) } END { exit !ok }' /proc/meminfo
}
model_start_memory_ok() {
    memory_at_least 3670016 || { swap_at_least 2097152 && memory_at_least 344064; }
}
model_running_memory_ok() {
    if swap_at_least 524288; then memory_at_least 212992; else memory_at_least 1003520; fi
}
configured=0

setpriv --no-new-privs --bounding-set=-all --reuid=minecraft --regid=minecraft --groups "$uid" \
    nice -n 10 taskset -c 0-3 /usr/bin/python3 -B /usr/local/lib/n20/wiki_chat.py 9>&- &
bridge=$!

while [ -f "$enabled" ]; do
    kill -0 "$bridge" || exit 1
    if [ -z "$model" ]; then
        if model_start_memory_ok && temperature_ok; then
            if [ "$configured" = 0 ]; then configure_profile; configured=1; fi
            echo "n20-wiki: starting $profile worker with memory reserve" >&2
            run_model "$profile" launch "$texture_key" 9>&- &
            model=$!
        fi
    elif ! model_running_memory_ok || ! temperature_ok; then
        echo "n20-wiki: stopping model to protect memory or temperature" >&2
        kill "$model" 2>/dev/null || :
        wait "$model" 2>/dev/null || :
        model=
        rm -f "$sock"
    elif ! kill -0 "$model" 2>/dev/null; then
        wait "$model" || :
        case "$profile" in
            texture-gdn2)
                next=texture
                if ! texture_key=$(run_model texture prepare-texture); then
                    next=tuned
                    texture_key=
                fi
                ;;
            texture) next=tuned ;;
            tuned) next=stock ;;
            *)
                echo "n20-wiki: stock worker stopped; waiting before retry" >&2
                model=
                rm -f "$sock"
                sleep 10
                continue
                ;;
        esac
        echo "n20-wiki: $profile worker stopped, retrying with $next OpenCL kernels" >&2
        profile=$next
        rm -f "$sock"
        model=
    fi
    sleep 1
done
